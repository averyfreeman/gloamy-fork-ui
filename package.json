{
  "name": "gloamy-web",
  "type": "module",
  "version": "0.1.9",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "clean": "rm -rf node_modules dist",
    "lint": "oxlint src tests vite.config.ts vitest.config.ts playwright.config.ts eslint.config.js --vue-plugin && eslint 'src/**/*.vue'",
    "lint:fix": "oxlint src tests vite.config.ts vitest.config.ts playwright.config.ts eslint.config.js --vue-plugin --fix && eslint 'src/**/*.vue' --fix",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test": "pnpm test:unit && pnpm build && pnpm test:smoke",
    "test:smoke": "playwright test",
    "test:unit": "vitest run",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.0.0",
    "@hugeicons/vue": "^1.0.5",
    "@tauri-apps/api": "^2.8.0",
    "@iconify-json/hugeicons": "^1.2.24",
    "@iconify-json/simple-icons": "^1.2.63",
    "@iconify/utils": "^3.1.0",
    "@lucide/vue": "^1.72.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vue/devtools-api": "^8.2.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/motion": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pinia": "^4.1.0",
    "reka-ui": "^2.6.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.34",
    "vue-i18n": "^11.1.12",
    "vue-router": "^5.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@tauri-apps/cli": "^2.8.0",
    "@iconify/vue": "^5.0.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-plugin-format": "^2.0.1",
    "happy-dom": "^21.0.4",
    "jiti": "^2.6.1",
    "oxlint": "^1.93.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
